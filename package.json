{
  "name": "schildpad",
  "private": true,
  "version": "0.1.0",
  "description": "A modern turtle-graphics environment for teaching programming, in Dutch and English.",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@schildpad/web",
    "dev:mobile": "turbo run start --filter=@schildpad/mobile",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@schildpad/web",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.7.0"
  }
}
